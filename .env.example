# Copy to .env and fill in credentials. Never commit .env to git.

# --- CognoDB Cloud (required) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# --- Neo4j Aura Free ---
NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Memgraph Cloud or self-hosted ---
MEMGRAPH_URI=bolt://localhost:7687
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# --- FalkorDB (self-hosted via docker-compose) ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# --- ArangoDB (self-hosted via docker-compose) ---
ARANGO_URL=http://localhost:8529
ARANGO_DB=graph_bench
ARANGO_USER=root
ARANGO_PASSWORD=graphbench

# --- Benchmark tuning ---
BENCH_ITERATIONS=100
BENCH_WARMUP=10
BENCH_CONCURRENCY=10,20,40
BENCH_PLATFORMS=cognodb,neo4j,memgraph,falkordb,arangodb
